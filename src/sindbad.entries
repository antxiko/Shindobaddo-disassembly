# Puntos de entrada que el trazado NO puede deducir solo.
#
# Cada uno lleva escrito POR QUE hace falta.

# El arranque: la cabecera da INIT en 0x4010.
0x4010   # INIT

# La interrupcion: INIT pone un "jp 0x4042" en el gancho H.KEYI (0xFD9A), 0x4035-0x403D.
0x4042

# Los saltos por tabla de 0x4325 ("ld a,(hl) / ... / dec a / add a,a / ... / jp (hl)": el estado de (HL), 1 la primera)
