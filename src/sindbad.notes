# SHINDOBADDO NANATSU NO BOUKEN (Casio, 1986) - anotaciones
# SHINDOBADDO NANATSU NO BOUKEN (Casio, 1986) - anotaciones
#
# LA ROM: 16 KB en la pagina 1 (0x4000-0x7FFF). La cabecera es "AB" e INIT (0x4010); el resto, a cero.
#
# LA INTERRUPCION va por el gancho H.KEYI (0xFD9A): INIT pone alli un "jp 0x4042" y se queda en un "jr $"
# (0x4040): todo el juego corre en la interrupcion.
L 0x4010 init                      El arranque: sin interrupciones, H.KEYI y H.TIMI con un "ret", la pila, la RAM 0xE000-0xF2FF a cero, la fila 0 del teclado (0xE000), la partida y la pantalla; H.KEYI a 0x4042 y el bucle vacio
C 0x4010 sin interrupciones
C 0x4011 un "ret"...
C 0x4013 ...en H.KEYI...
C 0x4016 ...y en H.TIMI
C 0x4019 la pila
C 0x401C 0xE000...
C 0x401F ...0x1300 bytes...
C 0x4022 ...a cero
C 0x4026 la fila 0 del teclado (las teclas 0-7)
C 0x4027 SNSMAT
C 0x402A el 0 al bit 7, las teclas 1-7 a los bits 0-6...
C 0x402B ...pulsada = 1
C 0x402C en 0xE000
C 0x402F lo de la partida
C 0x4032 la pantalla
C 0x4035 la interrupcion (0x4042)...
C 0x4038 ...en H.KEYI...
C 0x403B ...con su "jp"
L 0x4040 bucle_vacio               El bucle principal: nada; todo va en la interrupcion
C 0x4040 para siempre
L 0x4042 interrupcion              La interrupcion (H.KEYI): KILBUF, la del VDP cortada, los mandos, las cuentas; segun 0xE001 (bit 3, bit 4) unas cosas u otras; y el registro 1 otra vez con la interrupcion del VDP
C 0x4042 KILBUF: el buffer del teclado vacio
C 0x4045 el registro 1 a 0xC2: sin la interrupcion del VDP
C 0x4048 WRTVDP
C 0x404B los mandos
C 0x404E las cuentas de cuadros
C 0x4051 0xE001 bit 3?
L 0x4064 interrupcion_sigue
C 0x4064 0xE001 bit 4?
L 0x4078 interrupcion_otro
L 0x407E interrupcion_fin
C 0x4084 sin interrupciones
C 0x4085 el registro 1 a 0xE2...
C 0x4087 ...por el puerto 0x99...
C 0x4089 ...registro 1
C 0x408D el estado del VDP leido
L 0x4090 partida_pon               Lo de la partida: los numeros al azar, los puntos a cero, el record a 500, la fase de salida (las teclas 1-3 al encender, en binario: 1-8) y el estado 1
C 0x4093 el record: 500...
C 0x4096 ...en 0xE69E
C 0x40A3 el estado 1 (0xEAB1)
L 0x40AA pantalla_pon              La pantalla: DISSCR, las tablas de SCREEN 2 de 0x40DE en la RAM del sistema (GRPNAM...), INIGRP, registros 1 y 7, la VRAM a cero, los sprites fuera y ENASCR
C 0x40AA DISSCR
C 0x40AE las direcciones de las tablas...
C 0x40B1 ...a GRPNAM (0xF3C7)...
C 0x40B4 ...10 bytes
C 0x40B9 INIGRP: SCREEN 2
C 0x40BC el registro 1: 0xE2
C 0x40C2 el registro 7: 1 (el borde negro)
C 0x40C8 la VRAM...
C 0x40CF ...a cero
C 0x40D2 los sprites fuera
C 0x40D5 el registro 1 otra vez
C 0x40DB ENASCR
D 0x40DE 0x40E8 tablas_screen2      Las tablas de SCREEN 2 para la RAM del sistema (GRPNAM, GRPCOL, GRPCGP, GRPATR, GRPPAT): nombres 0x3800, colores 0x2000, dibujos 0x0000, atributos 0x3B00, sprites 0x1800
F 0x40DE w5
L 0x40E8 partida_borra             Una partida: dos numeros al azar, 0xE69A-0xE69D a cero, 0xE003 = 1, cinco vidas (0xEAE3) y la fase de salida (0xE002): las teclas 1, 2 y 3 al encender, en binario, + 1
C 0x40E8 el azar, dos veces
C 0x40EE los puntos a cero
C 0x40FA 0xE003 = 1
C 0x40FE cinco vidas
C 0x4103 las teclas 1, 2 y 3 al encender...
C 0x4108 ...+ 1
C 0x4109 hasta 7
C 0x410D si no, 1
L 0x410F partida_fase
C 0x410F la fase
L 0x4113 mandos                    Los mandos: la palanca del mando 1 o los cursores (0xE004); el boton 1 del mando o la barra (0xE005) y el boton 2 o GRAPH (0xE006), recien pulsados (0xE007 lo sostenido); en la demostracion, los de la lista
C 0x4113 GTSTCK 1: el mando 1
C 0x4119 quieto: los cursores
L 0x411E mandos_palanca
C 0x411E la palanca
C 0x4121 lo sostenido
C 0x4124 GTTRIG 1: el boton 1 del mando
C 0x412A pulsado?
C 0x412C GTTRIG 0: la barra (A = 0)
C 0x4130 suelto: salta a mitad del "ld bc" de 0x413B, que alli es "res 0,(hl)"
L 0x4132 mandos_boton1
C 0x4132 ya sostenido?
C 0x4136 sostenido
C 0x4138 recien pulsado
C 0x413B (desde 0x4130, este es "res 0,(hl)": suelto)
L 0x413E mandos_boton2
C 0x413E GTTRIG 3: el boton 2 del mando 1
C 0x4146 la fila 6: GRAPH (bit 2)
C 0x4148 SNSMAT
C 0x414E pulsado = 0xFF
C 0x4150 suelto: a mitad del "ld bc" de 0x415B ("res 1,(hl)")
L 0x4152 mandos_boton2_va
C 0x4152 ya sostenido?
C 0x4156 sostenido
C 0x4158 recien pulsado
C 0x415B (desde 0x4150, "res 1,(hl)")
L 0x415E mandos_demo
C 0x415E la demostracion (0xE001: bit 6, sin el 7)?
C 0x4166 un boton la corta
C 0x416D los botones a 0
C 0x4176 la lista
L 0x4190 mandos_demo_lista
C 0x4194 DCOMPR: al final de la lista?
C 0x4197 otra vez desde el principio (0x41CB)
L 0x419A mandos_demo_pon
L 0x419F mandos_demo_espera
L 0x41A7 mandos_demo_va
C 0x41A7 la palanca de la lista
C 0x41AD 0xE017?
C 0x41B2 al azar...
C 0x41B5 ...el boton
L 0x41BB demo_corta                El boton corta la demostracion: los estados a 0 y el estado 1
L 0x41D9 botones_cero              Los botones (0xE005 y 0xE006) a 0
L 0x41E0 cuentas                   Las cuentas de cuadros: nueve (0xE00C) de 9 a 0, y 0xE017 de 0 a 59
C 0x41E0 nueve cuentas
L 0x41E5 cuenta_una
C 0x41E5 una menos
C 0x41E9 por debajo de 0: otra vez
L 0x41EA cuenta_sig
C 0x41ED la de 60 cuadros
C 0x41F2 60?
L 0x41F8 marcador                  El marcador, escrito en la tabla de nombres (0x3800) con el puerto 0x98: los textos de 0x429D, los puntos, las vidas, la fase, el record...
C 0x41F8 la fila 0
C 0x41FB SETWRT
L 0x4260 marcador_cuenta           Tantas casillas L como A (como mucho 7) y el resto, hasta 8, en blanco
L 0x426A marcador_cuenta_blanco
L 0x426F vram_b_a                  B veces A a la VRAM, con espera
C 0x426F a la VRAM
C 0x4271 espera
L 0x427F numero_vram_byte
L 0x428B bcd_vram                  Las dos cifras de A a la VRAM (casillas 0x10 + cifra)
D 0x429D 0x42B4 marcador_textos     Los textos del marcador en casillas
L 0x42B4 puntos_suma               Los puntos + DE (BCD) si no es la demostracion; y el record
C 0x42B4 la demostracion: no
C 0x42C0 la suma BCD
L 0x42D0 record_mira
L 0x42D5 record_cifra
L 0x42DF record_nuevo
L 0x42F5 bordes                    Si el protagonista (0xEADC) pasa de los bordes, el estado 7 u 8
L 0x430C estado_8
L 0x4310 estado_7
L 0x4312 estado_pon
L 0x4316 bordes_izq
L 0x431D bordes_der
L 0x4325 estado_salta              Salta a la rutina del estado (HL) de la tabla DE (1 la primera); si cambia, (HL+1) = el estado y (HL+2) = 0 (su paso)
C 0x4325 el estado
C 0x4327 el de antes?
C 0x432A nuevo: apuntado...
C 0x432C ...y su paso a 0
L 0x432E estado_salta_va
C 0x432E 0: nada
L 0x4331 salta_tabla               Salta a la direccion A de la tabla HL
C 0x4339 jp (hl)
L 0x433B azar                      Un numero al azar: R, mas y xor con el anterior (0xE018)
C 0x433B el registro R
L 0x4348 mitad_alta                A / 16 (las cuatro rotaciones)
L 0x434D multiplica                HL = DE x A (8 bits)
L 0x4353 multiplica_bit
L 0x4357 multiplica_sig
L 0x435D suma_bcd                  HL = HL + DE en BCD
L 0x4366 llena                     BC bytes de A desde HL (con LDIR)
L 0x4380 espejo                    BC bytes de HL a DE con los bits al reves (el espejo)
L 0x4384 espejo_bit
L 0x4393 espejo_sprites            BC sprites de 32 bytes de HL a DE en espejo: los bits al reves y las dos mitades cambiadas
L 0x43B0 espejo_mitades
L 0x43B3 espejo_mitad
L 0x43CA desempaqueta_vram         Desempaqueta (0x43D0) y LDIRVM
L 0x43D0 desempaqueta              Desempaqueta B bloques de HL a 0xE6B1: cada bloque, un byte de mascara y 8 bytes; un bit a 1 lee un byte nuevo, a 0 repite el anterior; BC = B x 8 y HL = 0xE6B1
L 0x43D5 desempaqueta_bloque
L 0x43DC desempaqueta_bit
L 0x43E2 desempaqueta_pon
L 0x43F8 desempaqueta_tercios      Desempaqueta y a los tres tercios
L 0x43FB tercios                   LDIRVM a los tres tercios (DE + 0x800 cada vez)
L 0x43FD tercio
L 0x4410 espejo_vram               BC bytes de la VRAM (HL) a la RAM, su espejo y a los tres tercios
L 0x4429 ordenes_tercios           Las ordenes de casillas (0x4440) en los tres tercios
L 0x442B ordenes_tercio
L 0x443B ordenes_vram              Desde DE en la VRAM: parejas (valor, cuantas) hasta un 0
L 0x4440 ordenes_vram_una
L 0x444B vram_b                    B bytes de HL a la VRAM, con espera
L 0x4454 vram_b_atras              B bytes a la VRAM leyendo hacia atras
L 0x445B nombres_borra             La tabla de nombres (0x3800, 0x300) a cero
L 0x4465 sprites_fuera             Los atributos de los sprites (0x3B00, 128 bytes) a 0xC0: la Y fuera
L 0x4470 fondo_vram                El fondo (0xE11A, desde la columna 0xEAD1) a la tabla de nombres desde la fila 4: 18 filas de 32, salvo con 0xEAD2
C 0x4470 0xEAD2: no
C 0x4475 la fila 4
C 0x4478 SETWRT
C 0x447B el fondo en la RAM...
C 0x447E ...desde la columna que se ve
C 0x4485 la fila siguiente: + 32 (el fondo tiene 64 de ancho)
C 0x4488 18 filas
L 0x448A fondo_vram_fila
L 0x448B fondo_vram_casilla
C 0x448D a la VRAM
C 0x4496 el primero?
C 0x449C su sitio en el fondo
C 0x44A3 su ancho + 4
C 0x44A9 64 menos el ancho: a la fila siguiente
C 0x44AE la casilla 0x20
L 0x44B0 hueco1_fila1
L 0x44B6 hueco1_fila2
L 0x44BC hueco1_fila3
L 0x44C0 hueco2                    El segundo
C 0x44C0 el segundo?
C 0x44C6 su sitio
L 0x44DA hueco2_fila1
L 0x44E0 hueco2_fila2
L 0x44E6 hueco2_fila3
C 0x44EA la pila, guardada en HL'
C 0x44EF el final de la zona
C 0x44F2 dos casillas 0x20
C 0x44F5 la pila apunta alli
C 0x44F6 6 vueltas
L 0x44F8 pantalla_ram_borra_va
C 0x44F8 16 "push": 32 casillas
C 0x450A la pila de vuelta
C 0x450C los sprites y lo demas
C 0x4515 0xEACF?
C 0x451B cada tanto
C 0x4521 uno menos
L 0x4525 pantalla_ram_dibuja
C 0x4525 lo dibuja
L 0x4528 pantalla_ram_mas
C 0x4528 0xEACC?
L 0x4530 estado                    Cada cuadro: el estado general (0xEAB1) por la tabla 0x453D
C 0x4530 0xEAD2 = 0
C 0x4534 el estado
C 0x4537 la tabla
D 0x453D 0x454D tabla_estados       Los 8 estados generales (0xEAB1): 1 la presentacion (0x454D), 2 el titulo (0x471F), 3 (0x4B21), 4 y 6 (0x4A54), 5 (0x4AB6), 7 y 8 el protagonista por un borde (0x5624, 0x562D)
F 0x453D w8
L 0x454D presentacion              El estado 1: la presentacion de CASIO: en el primer paso, la pantalla en blanco y las casillas de CASIO; despues, cada 3 cuadros, los cuatro CASIO que se juntan; al acabar, el sonido de CASIO; con el boton, el titulo
C 0x454D el paso
C 0x4552 el primero?
C 0x4555 0xE001 = 0xC0
C 0x455A el sonido callado
C 0x455D DISSCR
C 0x4560 la tabla de nombres a cero
C 0x4563 los sprites fuera
C 0x4566 las casillas de CASIO, empaquetadas...
C 0x4569 ...a la casilla 0x10 de cada tercio
C 0x4571 y sus colores
C 0x457A el paso 1
C 0x457F la linea que baja (fila 0, columna 12)...
C 0x4585 ...y la que sube (fila 23)
C 0x458B ENASCR
L 0x458E presentacion_paso         Cada 3 cuadros
C 0x458E 3?
C 0x4593 otra vez 1
C 0x4595 los de arriba y abajo
C 0x4598 los de los lados
C 0x459B un paso mas
C 0x45A0 el 21?
C 0x45A4 desde el 9...
C 0x45A7 ...la linea de arriba baja una fila...
C 0x45B1 ...y la de abajo sube
L 0x45BA presentacion_junta        Juntos: el boton a 0, el sonido de CASIO (0xEC0D = 1) y el paso 5
C 0x45BF el sonido de CASIO
L 0x45C8 presentacion_espera       La espera: el boton o el final del sonido (0xF5) llevan al titulo (el estado 2)
C 0x45C9 el boton
C 0x45CD gastado
L 0x45D6 presentacion_fin
C 0x45D6 el estado 2: el titulo
D 0x45DC 0x45EF logotipo_casio      Las dos filas del logotipo de CASIO (0x45DD la de arriba, 0x45E6 la de abajo) con un 0 delante y detras
L 0x45EF presentacion_lineas       Desde el paso 9: los CASIO de arriba y de abajo, cada uno con una fila en blanco (0x4646) detras, que bajan y suben hacia el centro
C 0x45EF el paso 9?
C 0x45F5 8 casillas
C 0x45F8 la de abajo...
C 0x45FB ...en la linea que baja
C 0x4600 LDIRVM
C 0x460A la de arriba
C 0x460F LDIRVM
C 0x4619 una en blanco encima
C 0x461E LDIRVM
C 0x4623 el que sube: la de arriba
C 0x462A LDIRVM
C 0x4632 la de abajo
C 0x4637 LDIRVM
C 0x463F y una en blanco debajo
D 0x4646 0x464E fila_blanco         Ocho casillas 0: la fila en blanco detras de los CASIO que suben y bajan
L 0x464E presentacion_lados        Los dos CASIO de los lados en las filas 11 y 12: uno entra por la derecha casilla a casilla (tantas como el paso, 9 como mucho) y el otro por la izquierda, leido desde el final
C 0x464E el paso
C 0x4652 9 como mucho
L 0x4658 presentacion_lados_der
C 0x4658 la fila 12, desde la derecha
C 0x4660 la fila de arriba del logotipo
C 0x4665 LDIRVM
C 0x4668 una fila abajo
C 0x466D la de abajo
C 0x4677 9
L 0x4679 presentacion_lados_der2
C 0x467A LDIRVM
C 0x467D el otro: la fila 11
C 0x4688 pasado el 9, se mueve
L 0x468E presentacion_lados_izq
C 0x468F desde el final
L 0x4697 presentacion_lados_izq2
C 0x4698 LDIRVM
C 0x46A8 9
L 0x46AA presentacion_lados_izq3
C 0x46AA la de abajo desde el final
L 0x46B2 presentacion_lados_izq4
C 0x46B3 LDIRVM
D 0x46B6 0x471F casillas_casio      Las casillas de CASIO empaquetadas (16 bloques, 0x43D0) y las ordenes de sus colores (0x471A)
L 0x471F titulo                    El estado 2: el titulo. En el primer paso, las casillas (32 bloques de 0x509E desde la 0 y 78 de 0x4801 desde la 0x20), las letras de la BIOS, los colores, el recuadro verde y los textos; despues espera el boton 256 cuadros: con el boton, la partida; si no, la demostracion
C 0x471F el paso
C 0x4726 0xE00B a 0
C 0x472A el paso 1...
C 0x472D ...y la fase 1
C 0x4730 DISSCR
C 0x4733 la tabla de nombres a cero
C 0x4736 32 bloques de casillas empaquetadas...
C 0x4739 ...desde la casilla 0
C 0x473E en los tres tercios
C 0x4741 78 bloques...
C 0x4744 ...desde la casilla 0x20: el nombre en kanji y kana
C 0x474C las letras de la BIOS
C 0x474F todos los colores...
C 0x4755 ...blanco sobre transparente
C 0x475A desde la casilla 0x20...
C 0x4761 ...blanco sobre verde (0xFC)
C 0x4767 y en el segundo tercio
C 0x476F el recuadro verde: 9 filas...
C 0x4771 ...desde la fila 2, columna 6
L 0x4774 titulo_recuadro
C 0x4776 21 casillas...
C 0x4779 ...0x20 (verde)
C 0x477F la fila siguiente
C 0x4786 el nombre (0x49AC) desde la fila 3
C 0x478F en la fila 13, columna 10...
C 0x4792 ...la C en un circulo (0x6D)
C 0x4794 WRTVRM
C 0x4797 los textos (0x4A1C)
C 0x479D el record en la fila 15, columna 18
C 0x47A0 SETWRT
C 0x47A3 el record
C 0x47A9 ENASCR
L 0x47AC titulo_espera             El boton empieza la partida; 256 cuadros sin el, la demostracion (0xE001 = 0x40); las dos, el estado 4 con cinco vidas y la lista de mandos de la demostracion desde el principio
C 0x47AC el boton
C 0x47B0 gastado
C 0x47B5 un cuadro mas
C 0x47B8 aun no 256
C 0x47BA la demostracion
L 0x47BE titulo_partida
C 0x47BE una partida
C 0x47C1 sin demostracion
L 0x47C2 titulo_fin
C 0x47C2 0xE001
C 0x47C5 el estado 4
C 0x47CA cinco vidas
C 0x47CE la lista de mandos de la demostracion
L 0x47D5 textos_vram               Una lista de textos: (cuanto avanzar en la VRAM, las casillas hasta un 0)... y un 0 al final; HL la VRAM
C 0x47D5 cuanto avanzar
C 0x47D7 0: acaba
C 0x47D9 HL + eso
L 0x47DE texto_casilla
C 0x47DE una casilla
C 0x47E0 0: el texto siguiente
C 0x47E3 WRTVRM
L 0x47E9 letras_bios               Las letras de la BIOS ("0" a "_", 0x1D3F) a las casillas 0x80 del segundo y del tercer tercio
C 0x47E9 la fuente desde el "0"...
C 0x47EC ...a la casilla 0x80 del segundo tercio
C 0x47EF 0x180 bytes
C 0x47F2 LDIRVM
C 0x47F8 y del tercero
D 0x4801 0x49AC titulo_casillas     Los dibujos de las casillas del nombre (シンドバッド 7つの冒険), empaquetados: 78 bloques de mascara y 8 bytes
D 0x49AC 0x4A1C titulo_nombre       El nombre en casillas: (cuanto avanzar, las casillas, 0) seis veces y un 0
D 0x4A1C 0x4A54 titulo_textos       "1986 CASIO", "HIGH SCORE", "PUSH TRIGGER 1", "OR" y "SPACE KEY" en las casillas de la BIOS (0x80 + letra - 0x30; 0x1F el espacio)
L 0x4A54 ronda_cartel              Los estados 4 y 6: el cartel ROUND (la vuelta, 0xE003) e ISLAND (la isla, 0xE002) en el centro de la pantalla; la musica de la isla (la 7 desde la segunda vuelta, la isla + 4 en la primera); despues el estado 3
C 0x4A54 0xE001 sin el bit 3
C 0x4A59 la pantalla en blanco
C 0x4A5C las letras
C 0x4A5F en la fila 10, columna 12...
C 0x4A62 ...ROUND
C 0x4A6B la vuelta
C 0x4A6E en dos cifras
C 0x4A71 en la fila 12, columna 12...
C 0x4A74 ...ISLAND
C 0x4A7D la isla...
C 0x4A80 ...como cifra
C 0x4A84 0xE001 sin los bits 0 y 1
C 0x4A8B la primera vuelta?
C 0x4A91 la isla + 4...
C 0x4A96 ...hasta 7
L 0x4A9A ronda_musica7
C 0x4A9A la musica 7
L 0x4A9C ronda_musica
C 0x4A9C la musica (0xEB29)
C 0x4A9F 0xEAD3 = 8
C 0x4AA4 el estado 0
D 0x4AA9 0x4AB6 textos_ronda        "ROUND " e "ISLAND " en las casillas de la BIOS (0x80 + letra - 0x30)
L 0x4AB6 game_over                 El estado 5: GAME OVER. Las letras, la musica 5 (0xEC25 y 0xEC30); el cartel; cuando acaba la musica, 48 cuadros o el boton, y la presentacion
C 0x4AB6 el paso
C 0x4ABD el paso 1
C 0x4ABE la musica 5
L 0x4AC6 letras_pon                Las letras de la BIOS y sus colores (0x2C00, 0x400 bytes de blanco)
C 0x4AC9 los colores de las letras
C 0x4ACF blanco sobre transparente
L 0x4AD5 game_over_cartel
C 0x4AD5 el paso 1?
C 0x4AD9 en la fila 12, columna 12...
C 0x4ADC ...GAME OVER
C 0x4AE5 0xE001 sin el bit 3
L 0x4AEB game_over_musica
C 0x4AEB el paso 2: la musica acabada?
C 0x4AF3 el paso 3
C 0x4AF4 la cuenta y los botones a 0
L 0x4AFF game_over_espera
C 0x4AFF el boton?
C 0x4B05 cada 10 cuadros...
C 0x4B0A ...una mas
C 0x4B0E 48?
L 0x4B12 game_over_fin
C 0x4B12 el estado 1: la presentacion
D 0x4B18 0x4B21 texto_game_over     "GAME OVER" en las casillas de la BIOS
L 0x4B21 isla_pon                  El estado 3: la isla. Los dibujos (empaquetados: 0x509E, 0x51FF, 0x5208) y sus colores (0x52D6), los espejos de unas casillas, el fondo de la isla (0xE01A, 64 de ancho) desde la tabla de su isla (0x5496), los dos huecos (0x5411), los enemigos y las cosas de la isla; despues el marcador y ENASCR
C 0x4B21 DISSCR
C 0x4B24 los sprites fuera
C 0x4B27 59 bloques desde la casilla 0
C 0x4B32 uno a la casilla 0x3F
C 0x4B3D 34 desde la casilla 0x40
C 0x4B48 los colores
C 0x4B51 tres casillas con su espejo
C 0x4B60 y seis mas
C 0x4B6B el fondo (0xE01A, 0x600 bytes)...
